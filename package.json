{
  "name": "@dc-bgeo/react-native-background-geolocation",
  "version": "0.4.8",
  "description": "Reliable background geolocation for React Native (iOS & Android) — New Architecture, native HTTP upload, motion-based tracking.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/libs",
    "ios/RNBackgroundGeolocation.h",
    "ios/RNBackgroundGeolocation.mm",
    "ios/BGeoCore.xcframework",
    "RNBackgroundGeolocation.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "LICENSE.md",
    "README.md",
    "!**/__tests__",
    "!**/.gradle",
    "!**/build"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "echo \"tests live in ../core (host suites)\" && exit 0"
  },
  "codegenConfig": {
    "name": "RNBackgroundGeolocationSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.bgeo.rn"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dc-bgeo/react-native-background-geolocation.git"
  },
  "homepage": "https://bgeo.dev",
  "bugs": {
    "url": "https://github.com/dc-bgeo/react-native-background-geolocation/issues"
  },
  "keywords": [
    "react-native",
    "geolocation",
    "background",
    "location",
    "gps",
    "tracking"
  ]
}
