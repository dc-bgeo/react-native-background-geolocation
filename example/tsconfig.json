{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    // The package under development is symlinked from ../ and has no
    // node_modules of its own — resolve react/react-native here.
    "baseUrl": ".",
    "paths": {
      "react-native": ["./node_modules/react-native"], "@dc-bgeo/react-native-background-geolocation": ["../src"],
      "react-native/*": ["./node_modules/react-native/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
